+/* ---- U-045 per-frame RAM trace ------------------------------------------
+ * Sampling $FF0006 (the game's MainLoop iteration counter) once per emulated
+ * frame is how a turn boundary becomes visible: normally it advances once per
+ * frame, and a long computation shows up as a run of frames where it does not
+ * move at all.  Doing this through the debugger REPL costs two commands per
+ * frame, which is unusable over the ~30,000 frames needed to span several
+ * quarters, so it is a direct hook on the frame loop instead. */
+/* ---- U-045 per-frame 68000 PC sampler -----------------------------------
+ * The only route to the 68000's PC from outside the core is the savestate:
+ * CHUNK_M68K (id 1) carries it as a little-endian longword at offset 0x40.
+ * Serialising once per frame into a reusable buffer is cheap enough for the
+ * ~426,000 frames a full demo game takes, and it is what turns "the game
+ * stalled" into "the game stalled inside this routine". */
+static FILE *aero_pc_file;
+static unsigned char *aero_pc_buf;
+static size_t aero_pc_bufsz;
+static unsigned aero_pc_every = 1;
+
+static int aero_pc_extract(uint32_t *pc_out) {
+    size_t i = 12;                      /* past "PicoSEXT" + version */
+    if (!aero_pc_buf || aero_pc_bufsz < 17) return 0;
+    while (i + 5 <= aero_pc_bufsz) {
+        unsigned char id = aero_pc_buf[i];
+        uint32_t len = (uint32_t)aero_pc_buf[i+1]
+                     | ((uint32_t)aero_pc_buf[i+2] << 8)
+                     | ((uint32_t)aero_pc_buf[i+3] << 16)
+                     | ((uint32_t)aero_pc_buf[i+4] << 24);
+        i += 5;
+        if (id == 1) {
+            const unsigned char *b;
+            if (len < 0x44 || i + len > aero_pc_bufsz) return 0;
+            b = aero_pc_buf + i + 0x40;
+            *pc_out = (uint32_t)b[0] | ((uint32_t)b[1] << 8)
+                    | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+            return 1;
+        }
+        if (len > aero_pc_bufsz - i) return 0;
+        i += len;
+    }
+    return 0;
+}
